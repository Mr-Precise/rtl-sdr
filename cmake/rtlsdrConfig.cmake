find_package(PkgConfig QUIET)
if(PKG_CONFIG_FOUND)
  pkg_check_modules(LIBUSB QUIET libusb-1.0 IMPORTED_TARGET)
endif()

get_filename_component(RTLSDR_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)

if(NOT TARGET rtlsdr::rtlsdr_shared AND NOT TARGET rtlsdr::rtlsdr_static)
  include("${RTLSDR_CMAKE_DIR}/rtlsdrTargets.cmake")
endif()

if(NOT TARGET rtlsdr::rtlsdr)
  if(TARGET rtlsdr::rtlsdr_shared)
    add_library(rtlsdr::rtlsdr INTERFACE IMPORTED)
    set_target_properties(rtlsdr::rtlsdr PROPERTIES INTERFACE_LINK_LIBRARIES "rtlsdr::rtlsdr_shared")
  elseif(TARGET rtlsdr::rtlsdr_static)
    add_library(rtlsdr::rtlsdr INTERFACE IMPORTED)
    set_target_properties(rtlsdr::rtlsdr PROPERTIES INTERFACE_LINK_LIBRARIES "rtlsdr::rtlsdr_static")
  endif()
endif()

set(RTLSDR_FOUND TRUE)
set(rtlsdr_FOUND TRUE)

if(TARGET rtlsdr::rtlsdr)
  set(RTLSDR_LIBRARIES rtlsdr::rtlsdr)
  set(rtlsdr_LIBRARIES rtlsdr::rtlsdr)
  if(TARGET rtlsdr::rtlsdr_shared)
    get_target_property(RTLSDR_INCLUDE_DIRS rtlsdr::rtlsdr_shared INTERFACE_INCLUDE_DIRECTORIES)
  elseif(TARGET rtlsdr::rtlsdr_static)
    get_target_property(RTLSDR_INCLUDE_DIRS rtlsdr::rtlsdr_static INTERFACE_INCLUDE_DIRECTORIES)
  endif()
  set(rtlsdr_INCLUDE_DIRS ${RTLSDR_INCLUDE_DIRS})
endif()